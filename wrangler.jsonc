{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "udv-shop-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Sem isto não existe log de Worker para investigar erro em produção.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // O SSR chama a API no Brasil a cada página; deixar a Cloudflare aproximar o Worker da
  // origem corta uma volta de latência por requisição.
  "placement": { "mode": "smart" },
  // Zona colheita.app ativa na conta desde 2026-08-21. custom_domain cria o DNS e o
  // certificado sozinho no primeiro deploy.
  "routes": [{ "pattern": "colheita.app", "custom_domain": true }]
}
