# API do udv-shop (SSR e browser usam a mesma base)
VITE_API_URL=http://localhost:3333
# origem pública do site — usada em canonical, og:url e sitemap
VITE_SITE_URL=http://localhost:3000

# chave publicável do Stripe (prefixo pk_) — sem ela o cartão fica indisponível e o
# checkout oferece só Pix
VITE_STRIPE_PUBLISHABLE_KEY=

# chave pública do Turnstile — sem ela o desafio anti-robô não aparece nas telas sem
# conta. Precisa vir junto do TURNSTILE_SECRET_KEY da API: só a pública mostra um
# desafio que ninguém valida.
VITE_TURNSTILE_SITE_KEY=
